    <!-- Permissions onboarding -->
    <string name="perm_title">Настройка разрешений</string>
    <string name="perm_intro">Для записи поездок, работы с датчиками и отслеживания в фоне приложению нужны разрешения. Запрашиваем их по шагам с пояснениями. Можно пропустить, но часть функций может быть ограничена.</string>
    <string name="perm_step_of">Шаг %1$d из %2$d</string>
    <string name="perm_status_granted">Статус: разрешено</string>
    <string name="perm_status_denied">Статус: не разрешено</string>
    <string name="perm_denied_forever">Похоже, разрешение отклонено навсегда. Откройте настройки приложения, чтобы выдать его вручную.</string>
    <string name="perm_open_settings">Настройки</string>
    <string name="perm_location_title">Местоположение</string>
    <string name="perm_location_rationale">Для записи GPS-маршрута, скорости и навигации по треку во время велотренировки.</string>
    <string name="perm_bt_title">Bluetooth (датчики)</string>
    <string name="perm_bt_rationale">Для подключения датчиков пульса, каденса, мощемеров и умных велостанков по Bluetooth (BLE).</string>
    <string name="perm_notifications_title">Уведомления</string>
    <string name="perm_notifications_rationale">Нужно для показа уведомления об активной поездке и управления записью в фоне (Android 13+).</string>
    <string name="perm_bg_location_title">Фоновое местоположение</string>
    <string name="perm_bg_location_rationale">Для записи GPS-маршрута, скорости и навигации, когда экран выключен или приложение в фоне во время тренировки.</string>
    <string name="perm_hint_location">Без разрешения на местоположение запись трека, скорость и дистанция не будут работать.</string>
    <string name="perm_hint_bt">Без разрешения Bluetooth поиск и подключение датчиков будут недоступны (показатели GPS продолжат работать).</string>
    <string name="perm_hint_notifications">Без разрешения на уведомления система может ограничить запись в фоне на Android 13+.</string>
    <string name="perm_hint_bg_location">Без фонового местоположения запись может остановиться при сворачивании приложения или выключении экрана.</string>
    <string name="perm_hint_default">Это разрешение помогает приложению работать корректно.</string>

