    <!-- Permissions onboarding -->
    <string name="perm_title">Permissions setup</string>
    <string name="perm_intro">To record rides, work with sensors, and track in background, the app needs permissions. We request them step by step with explanations. You can skip, but some features may be limited.</string>
    <string name="perm_step_of">Step %1$d of %2$d</string>
    <string name="perm_status_granted">Status: granted</string>
    <string name="perm_status_denied">Status: not granted</string>
    <string name="perm_denied_forever">Permission appears to be permanently denied. Open app settings to grant it manually.</string>
    <string name="perm_open_settings">Settings</string>
    <string name="perm_location_title">Location</string>
    <string name="perm_location_rationale">For recording GPS route, speed, and track navigation during bike workouts.</string>
    <string name="perm_bt_title">Bluetooth (sensors)</string>
    <string name="perm_bt_rationale">For connecting heart rate, cadence, power sensors, and smart trainers via Bluetooth (BLE).</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_rationale">Needed to show the active ride notification and control background tracking (Android 13+).</string>
    <string name="perm_bg_location_title">Background location</string>
    <string name="perm_bg_location_rationale">For recording GPS route, speed, and navigation when the screen is off or the app is in background during a workout.</string>
    <string name="perm_hint_location">Without location permission, track recording, speed, and distance will not work.</string>
    <string name="perm_hint_bt">Without Bluetooth permission, sensor search and connection will be unavailable (GPS metrics will still work).</string>
    <string name="perm_hint_notifications">Without notification permission, the system may restrict background tracking on Android 13+.</string>
    <string name="perm_hint_bg_location">Without background location, recording may stop when the app is minimized or the screen is off.</string>
    <string name="perm_hint_default">This permission helps the app work correctly.</string>

